{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install",
  "buildCommand": "pnpm run build",
  "crons": [
    {
      "path": "/api/cron/recurring",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/earn",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/save",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/payroll",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/earn-auto-deposit",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/operator-health",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/checkout",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/multichain",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/ledger",
      "schedule": "0 16 * * *"
    }
  ]
}
