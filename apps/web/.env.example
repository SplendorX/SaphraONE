CIRCLE_API_KEY=
CIRCLE_BASE_URL=
CIRCLE_ENTITY_SECRET=
# Funded Arc Testnet wallet private key for the server-side App Kit Earn adapter.
# Never prefix this with NEXT_PUBLIC_ or VITE_. Leave blank in git; fill locally.
PRIVATE_KEY=
EVM_WALLET_ADDRESS=
TREASURY_WALLET=
KIT_KEY=
# Circle Onramp (Buy USDC by bank transfer). Mainnet key from the Circle
# console, server-only. Leave blank on testnet: the deposit page hides it.
ONRAMP_API_KEY=
# Hostname that embeds the widget; defaults to NEXT_PUBLIC_APP_URL's host.
# Checkout's "Card or bank" option uses the same two keys and is hidden
# while ONRAMP_API_KEY is blank.
ONRAMP_REFERRER_DOMAIN=
# Optional dedicated Arc RPC for server reads (payment notifications, and
# Checkout's matching of card/bank and cross-chain payments).
ARC_SERVER_RPC_URL=
# SaphraONE Checkout entry points (quick actions, app shortcut, receive QR,
# overview card). "true" to show them; the /business/checkout, /c and /p
# pages work by URL either way. Build-time: redeploy after changing it.
NEXT_PUBLIC_CHECKOUT_ENABLED=
# Encrypts two-factor (authenticator) secrets at rest: 32 random bytes as hex
# (`openssl rand -hex 32`). Its own key per environment; never reuse or rotate
# casually — rotating it turns off everyone's 2FA. Without it 2FA can't be on.
SAPHRA_MFA_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_CIRCLE_BASE_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=
NEXT_PUBLIC_CIRCLE_KIT_KEY=
NEXT_PUBLIC_SAPHRA_BULKPAY_ADDRESS=
NEXT_PUBLIC_SAPHRA_SEND_ADDRESS=
NEXT_PUBLIC_SWIFT_SAVE_VAULT_ADDRESS=0xcBF3559D59b536cc3aB55C32e502F72Bd111588a
NEXT_PUBLIC_PLATFORM_FEE_RECIPIENT=
NEXT_PUBLIC_ARC_NETWORK=testnet
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_EURC_ADDRESS=
PLATFORM_FEE_RECIPIENT=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SAPHRA_SESSION_SECRET=
SUPABASE_BENEFICIARIES_TABLE=beneficiaries
SUPABASE_RECURRING_SCHEDULES_TABLE=recurring_schedules
SUPABASE_RECURRING_EXECUTIONS_TABLE=recurring_executions
NEXT_PUBLIC_SAPHRA_RECUREPAY_ADDRESS=
SAPHRA_RECURRING_OPERATOR_ADDRESS=
SAPHRA_RECURRING_OPERATOR_PRIVATE_KEY=
RECURRING_AUTOPAY_SHADOW=
CIRCLE_WEBHOOK_SECRET=
CRON_SECRET=
# Required for Circle Save/Earn deposits to credit. Falls back to TREASURY_WALLET.
SAPHRA_CIRCLE_TREASURY_ADDRESS=

# ─── SaphraONE Unified Payment Engine (Phases A–C) ───────────────────────────
SUPABASE_PAYMENT_INTENTS_TABLE=payment_intents
SUPABASE_PAYMENT_ATTEMPTS_TABLE=payment_attempts
SUPABASE_PAYMENT_SETTLEMENTS_TABLE=payment_settlements
SUPABASE_PAYMENT_POLICIES_TABLE=payment_policies

# ─── Phase E — Agent Wallet (Developer-Controlled Wallets) ──────────────────
CIRCLE_DEVELOPER_CONTROLLED_API_KEY=
CIRCLE_ENTITY_SECRET=
SUPABASE_AGENT_WALLET_CONFIGS_TABLE=agent_wallet_configs

# ─── Phase H — ALLIE (Anthropic) ────────────────────────────────────────────
ANTHROPIC_API_KEY=
ALLIE_TIER_TWO_MODEL=claude-haiku-4-5
ALLIE_TIER_THREE_MODEL=claude-sonnet-5

# ─── ALLIE Monetization ─────────────────────────────────────────────────────
ALLIE_PRO_MONTHLY_FEE_USDC=5.00
ALLIE_PER_PAYMENT_FEE_UNITS=2000      # 0.002 USDC at 6 decimals, per policy-approved payment
#ALLIE_PER_CALL_FEE_UNITS=            # deprecated name, still read as a fallback
ALLIE_DAILY_LLM_CALL_BUDGET=50        # total LLM calls per Pro user per day
ALLIE_DAILY_ESCALATION_BUDGET=10      # of those, how many may reach Tier 3
ALLIE_PRO_FEE_RECIPIENT=
SUPABASE_ALLIE_SUBSCRIPTIONS_TABLE=allie_subscriptions
SUPABASE_ALLIE_LLM_USAGE_TABLE=allie_llm_usage
SUPABASE_ALLIE_LLM_CACHE_TABLE=allie_llm_cache

# Optional: CoinGecko demo API key for the dashboard coin detail (market data works without it, at the shared free-tier rate limit).
COINGECKO_API_KEY=

# Optional, free: automatic business verification for the UK and Australia.
# Without them those businesses are reviewed by hand at /admin/business-verifications.
# Companies House key: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=
# ABN Lookup GUID: https://abr.business.gov.au/Tools/WebServices
ABN_LOOKUP_GUID=

# SaphraONE transaction confirmation (lib/tx-approval). Google and email wallets
# confirm payments with Face ID / fingerprint, PIN or 2FA code instead of
# Circle's popup. Run packages/database/supabase/tx-approvals.sql first, turn
# this on, THEN switch off Circle's confirmation UI for the same environment
# (Circle Console > Configurator > Wallet Security Settings). Never the other
# way round: in between, payments would have no confirmation at all.
NEXT_PUBLIC_TX_APPROVAL=false
# Payments at or above these (US dollars) also need a code emailed to the
# account, showing the real amount and recipient.
TX_APPROVAL_LARGE_USD=1000
TX_APPROVAL_NEW_RECIPIENT_USD=100
TX_APPROVAL_DAILY_USD=5000
# Security emails go through Resend (RESEND_API_KEY, RESEND_EMAIL_DOMAIN).
# TX_SECURITY_EMAIL_FROM=SaphraONE Security <security@example.com>
# Set to false to stop the email sent after every approved transaction.
TX_APPROVAL_NOTICE_EMAILS=true

# Rewards v2 (REWARDS-PLAN.md): OnePoints Rewards page (monthly cashback tiers,
# streaks, quests, discounts on premium purchases) and USDC Invite & Earn.
# Run packages/database/supabase/rewards-v2.sql first. Discounts and referral
# claims pay from the OnePoints treasury (ONE_POINTS_TREASURY_PRIVATE_KEY).
# Rewards v2 is live by default; set to false only to switch it off in an emergency.
# NEXT_PUBLIC_REWARDS_V2=false

# Centiiv Protocol (Naira on/off-ramp on Arc, CENTIIV-RAMP-PLAN.md). Server-only.
# sk_sandbox_... on testnet builds, sk_live_... on mainnet; a mismatch disables the feature.
CENTIIV_API_KEY=
CENTIIV_API_BASE_URL=https://api.centiiv.io
# Svix signing secret (whsec_...) from Centiiv dashboard -> Webhooks.
# Webhook URL to set there: https://<app-host>/api/ramp/webhooks/centiiv
CENTIIV_WEBHOOK_SECRET=
RAMP_CURRENCIES=NGN
# Shows the Withdraw quick action. Build-time; redeploy after changing.
NEXT_PUBLIC_RAMP_ENABLED=
