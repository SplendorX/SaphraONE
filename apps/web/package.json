{
  "name": "@saphra/web",
  "version": "1.0.0",
  "description": "SaphraONE fintech wallet payments frontend.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:turbo": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "dev:clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; try { rmSync('.next', { recursive: true, force: true }); } catch {}\" && next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && pnpm run test:save && pnpm run test:save-activity && pnpm run test:recurring && pnpm run test:circle && pnpm run test:payroll && pnpm run test:referral && pnpm run test:activity && pnpm run test:payment-engine && pnpm run test:fees && pnpm run test:account && pnpm run test:business-verification && pnpm run test:support && pnpm run test:allie && pnpm run test:checkout && pnpm run test:recurepay && pnpm run test:multichain && pnpm run test:tx-approval && pnpm run test:rewards && pnpm run test:ledger && pnpm run test:campaigns && pnpm run test:account-deletion && pnpm run test:circle-device && pnpm run test:one-id && pnpm run test:admin && pnpm run test:ramp",
    "test:save": "node --test lib/save/__tests__/decimal-target.test.mjs lib/save/__tests__/security-integration.test.mjs lib/save/__tests__/lock.test.mjs",
    "test:save-activity": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/save/__tests__/activity.test.mjs",
    "test:recurring": "node --test lib/recurring/__tests__/autonomous-autopay.test.mjs",
    "test:circle": "node --test lib/swift-circle/__tests__/swift-circle.test.mjs",
    "test:payroll": "node --test lib/payroll/__tests__/payroll.test.mjs",
    "test:referral": "node --test lib/referral/__tests__/referral-system.test.mjs",
    "test:activity": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/activity/__tests__/merge.test.mjs lib/activity/__tests__/insights.test.mjs",
    "test:fees": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/__tests__/fees.test.mjs",
    "test:payment-engine": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/payment-engine/__tests__/payment-engine.test.mjs",
    "test:account": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/account/__tests__/verify-invoice-payment.test.mjs",
    "test:business-verification": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/business/__tests__/verification.test.mjs",
    "test:support": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/support/__tests__/match.test.mjs",
    "test:checkout": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/checkout/__tests__/codes.test.mjs lib/checkout/__tests__/money-rules.test.mjs lib/checkout/__tests__/verify.test.mjs lib/checkout/__tests__/match.test.mjs lib/__tests__/sign-in-destination.test.mjs",
    "test:recurepay": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/recurring/__tests__/recurepay-plan.test.mjs",
    "test:multichain": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/multichain/__tests__/rules.test.mjs lib/multichain/__tests__/chains.test.mjs",
    "test:tx-approval": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/tx-approval/__tests__/approval-rules.test.mjs",
    "test:rewards": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/rewards/__tests__/rewards.test.mjs",
    "test:ledger": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/ledger/__tests__/classify.test.mjs",
    "test:campaigns": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/campaigns/__tests__/rules.test.mjs",
    "test:account-deletion": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/account-deletion/__tests__/rules.test.mjs",
    "test:circle-device": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/__tests__/circle-device.test.mjs",
    "test:one-id": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/__tests__/one-id.test.mjs",
    "test:admin": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/__tests__/admin-tools.test.mjs",
    "test:ramp": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/ramp/__tests__/rules.test.mjs lib/ramp/__tests__/centiiv-map.test.mjs lib/ramp/__tests__/webhook-signature.test.mjs lib/ramp/__tests__/verify.test.mjs",
    "test:allie": "node --experimental-strip-types --import ./lib/payment-engine/__tests__/register.mjs --test lib/allie/__tests__/classifier.test.mjs lib/allie/__tests__/capabilities.test.mjs lib/allie/__tests__/agent-fees.test.mjs lib/allie/__tests__/business.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@circle-fin/adapter-circle-wallets": "^1.8.0",
    "@circle-fin/adapter-viem-v2": "^1.18.0",
    "@circle-fin/app-kit": "^1.15.3",
    "@circle-fin/bridge-kit": "^1.10.0",
    "@circle-fin/developer-controlled-wallets": "^10.6.0",
    "@circle-fin/onramp-kit": "1.0.2",
    "@circle-fin/w3s-pw-web-sdk": "^1.1.11",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@reown/appkit": "^1.7.8",
    "@reown/appkit-adapter-wagmi": "^1.7.8",
    "@reown/appkit-controllers": "^1.7.8",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@supabase/supabase-js": "^2.106.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "@walletconnect/sign-client": "^2.23.9",
    "@walletconnect/universal-provider": "^2.23.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookies-next": "^6.1.1",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "framer-motion": "^12.40.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.18.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.14",
    "qr": "^0.6.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^6.19.7",
    "uuid": "^14.0.0",
    "viem": "^2.49.3",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3"
  }
}
