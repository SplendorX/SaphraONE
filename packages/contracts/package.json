{
  "name": "@saphra/contracts",
  "version": "1.0.0",
  "description": "SaphraONE smart contracts and deployment scripts.",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:earn": "hardhat test test/earn/EarnAutoSaveExecutor.js",
    "test:payroll": "hardhat test test/payroll/SwiftPayrollExecutor.js",
    "deploy": "hardhat run contracts/deploy.js --network arcTestnet",
    "deploy:timelock": "node contracts/deployTimelock.js",
    "deploy:timelock:mainnet": "node contracts/deployTimelock.js --mainnet",
    "deploy:batchpay": "node contracts/deployBatchPay.js",
    "deploy:swiftpaysend": "node contracts/deploySwiftPaySend.js",
    "deploy:swiftpaysend:mainnet": "node contracts/deploySwiftPaySend.js --mainnet",
    "deploy:saphrasend": "node contracts/deploySaphraSend.js",
    "deploy:saphrasend:mainnet": "node contracts/deploySaphraSend.js --mainnet",
    "deploy:saphrabulkpay": "node contracts/deploySaphraFees.js bulkpay",
    "deploy:saphrabulkpay:mainnet": "node contracts/deploySaphraFees.js bulkpay --mainnet",
    "deploy:saphrarecurepay": "node contracts/deploySaphraFees.js recurepay",
    "deploy:saphrarecurepay:mainnet": "node contracts/deploySaphraFees.js recurepay --mainnet",
    "deploy:saphrapayroll": "node contracts/deploySaphraFees.js payroll",
    "deploy:saphrapayroll:mainnet": "node contracts/deploySaphraFees.js payroll --mainnet",
    "set:feerecipient": "node contracts/setFeeRecipient.js",
    "set:feerecipient:mainnet": "node contracts/setFeeRecipient.js --mainnet",
    "deploy:recurepay": "node contracts/deployRecurePayExecutor.js",
    "retire:recurepay": "node contracts/retireRecurePayExecutor.js",
    "check:recurepay": "node contracts/checkRecurePayOperator.js",
    "deploy:earn:autodeposit": "node contracts/deployEarnAutoSaveExecutor.js",
    "deploy:payroll:executor": "node contracts/deploySaphrarollExecutor.js",
    "rotate:operator": "node contracts/rotateOperator.js",
    "rotate:payroll:operator": "node contracts/rotateOperator.js payroll",
    "rotate:recurring:operator": "node contracts/rotateOperator.js recurring",
    "rotate:earn:operator": "node contracts/rotateOperator.js earn",
    "deploy:swiftsave": "hardhat run contracts/deploySwiftSave.js --network arcTestnet",
    "deploy:swiftsave:local": "hardhat run contracts/deploySwiftSave.js",
    "deploy:swiftsave:mainnet": "hardhat run contracts/deploySwiftSave.js --network arcMainnet",
    "test:save": "hardhat test test/save/SwiftSaveVault.js",
    "test:recurepay": "hardhat test test/recurepay/RecurePayExecutor.js",
    "multisig": "node contracts/multisig.js",
    "check:governance": "node contracts/checkGovernance.js",
    "check:governance:mainnet": "node contracts/checkGovernance.js --mainnet"
  },
  "dependencies": {
    "@circle-fin/smart-contract-platform": "^10.3.1",
    "@openzeppelin/contracts": "5.4.0",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-mocha": "^3.1.0",
    "@nomicfoundation/hardhat-verify": "^3.0.20",
    "@types/chai": "^5.2.3",
    "chai": "^6.2.2",
    "ethers": "^6.16.0",
    "hardhat": "^3.12.0",
    "mocha": "^11.8.0"
  }
}
