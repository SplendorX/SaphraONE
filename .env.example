CIRCLE_API_KEY=
CIRCLE_BASE_URL=
CIRCLE_ENTITY_SECRET=
# Funded Arc Testnet wallet private key for the server-side App Kit Earn adapter.
# Never prefix this with NEXT_PUBLIC_ or VITE_. Leave blank in git; fill locally.
PRIVATE_KEY=
EVM_WALLET_ADDRESS=
TREASURY_WALLET=
KIT_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_APP_URL=

# Developer platform (Checkout API). Each deployment serves one mode: mainnet
# is live, testnet is the sandbox. Attach the portal and API hosts of that mode
# to its deployment; the other mode's URLs power the Sandbox / Live switch.
# Empty uses the defaults: https://developers.saphra.one,
# https://sandbox.developers.saphra.one, https://api.saphra.one and
# https://sandbox.api.saphra.one.
NEXT_PUBLIC_DEVELOPERS_LIVE_URL=
NEXT_PUBLIC_DEVELOPERS_SANDBOX_URL=
NEXT_PUBLIC_API_LIVE_URL=
NEXT_PUBLIC_API_SANDBOX_URL=
NEXT_PUBLIC_CIRCLE_APP_ID=
NEXT_PUBLIC_CIRCLE_BASE_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=
# New email accounts use Circle's own email login (no PIN), so SaphraONE's
# own confirmation is the only one. Accounts on the older PIN wallet keep it.
# An address that signs in one way (email or Google) is sent back to it.
# Needs Email turned on, with real SMTP, in Circle Console → Configurator,
# and packages/database/supabase/email-sign-in.sql run first.
# On by default; set to false to keep every email sign-in on the PIN wallet.
NEXT_PUBLIC_CIRCLE_EMAIL_SIGN_IN=true
NEXT_PUBLIC_CIRCLE_KIT_KEY=
NEXT_PUBLIC_SAPHRA_BULKPAY_ADDRESS=
NEXT_PUBLIC_SAPHRA_SEND_ADDRESS=
NEXT_PUBLIC_PLATFORM_FEE_RECIPIENT=

# ─── Arc network target ──────────────────────────────────────────────────────
# Stay on testnet until official Arc mainnet chain ID, RPC, explorer, and
# USDC/EURC addresses are published. Never invent those values.
NEXT_PUBLIC_ARC_NETWORK=testnet
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_EURC_ADDRESS=
NEXT_PUBLIC_ARC_CHAIN_ID=
NEXT_PUBLIC_ARC_RPC_URL=
# Optional extra Arc RPCs (comma-separated), tried when the main one fails.
# Public drpc/thirdweb backups are built in (lib/network.ts).
NEXT_PUBLIC_ARC_RPC_FALLBACK_URLS=
ARC_MAINNET_EURC=
PLATFORM_FEE_RECIPIENT=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SAPHRA_SESSION_SECRET=
SUPABASE_BENEFICIARIES_TABLE=beneficiaries
SUPABASE_RECURRING_SCHEDULES_TABLE=recurring_schedules
SUPABASE_RECURRING_EXECUTIONS_TABLE=recurring_executions
NEXT_PUBLIC_SAPHRA_RECUREPAY_ADDRESS=
SAPHRA_RECURRING_OPERATOR_ADDRESS=
SAPHRA_RECURRING_OPERATOR_PRIVATE_KEY=
# Optional: record occurrences without submitting while testing the scheduler.
RECURRING_AUTOPAY_SHADOW=
# Optional: HMAC secret for POST /api/recurring/webhooks/circle
CIRCLE_WEBHOOK_SECRET=
CRON_SECRET=
# SwiftCircle pooled Save/Earn treasury. Required for deposits to credit.
# Falls back to TREASURY_WALLET, then SAPHRA_RECURRING_OPERATOR_ADDRESS, then EVM_WALLET_ADDRESS.
# Must match the operator key if withdrawals execute autonomously.
SAPHRA_CIRCLE_TREASURY_ADDRESS=

# ─── SaphraONE Earn (Circle App Kit vaults) ──────────────────────────────────
# ERC-4626 vault EarnAutoSaveExecutor deposits into (deploy:earn:autodeposit).
EARN_VAULT_ADDRESS=
# One executor per vault, for unattended deposits: vault=executor,vault=executor
NEXT_PUBLIC_EARN_AUTOSAVE_EXECUTORS=
# Arc mainnet, from https://docs.arc.io/arc/references/connect-to-arc
ARC_MAINNET_CHAIN_ID=
ARC_MAINNET_RPC_URL=
ARC_MAINNET_USDC=
ARC_MAINNET_EXPLORER=
# Frontend (copy from deploy output):
NEXT_PUBLIC_EARN_VAULT_ADDRESS=
NEXT_PUBLIC_EARN_MODE=simulation
NEXT_PUBLIC_EARN_PERFORMANCE_FEE_BPS=1000
NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.arcscan.app
NEXT_PUBLIC_EARN_AUTOSAVE_EXECUTOR_ADDRESS=
SAPHRA_EARN_OPERATOR_PRIVATE_KEY=
EARN_ADMIN_SECRET=

# ─── Swift+Save (non-interest savings pockets + Spend&Save) ──────────────────
# Deploy: pnpm contracts:deploy-swiftsave
# Apply SQL: packages/database/supabase/swift-save.sql
# NO yield / APY / interest — segregated savings only.
NEXT_PUBLIC_SWIFT_SAVE_VAULT_ADDRESS=0xcBF3559D59b536cc3aB55C32e502F72Bd111588a
SUPABASE_SAVINGS_POCKETS_TABLE=savings_pockets
SUPABASE_SAVINGS_TRANSACTIONS_TABLE=savings_transactions

# ─── Account Activity ───────────────────────────────────────────────────────
# Apply packages/database/supabase/account-activity.sql before enabling.
SUPABASE_ACCOUNT_ACTIVITY_TABLE=account_activity

# ─── Traction Analytics ─────────────────────────────────────────────────────
# Apply packages/database/supabase/traction-events.sql before enabling.
SUPABASE_TRACTION_EVENTS_TABLE=traction_events
# Bearer secret for /admin/traction and /api/admin/traction.
TRACTION_ADMIN_SECRET=
SUPABASE_SPEND_SAVE_CONFIGS_TABLE=spend_save_configs
SUPABASE_SPEND_SAVE_EVENTS_TABLE=spend_save_events
SUPABASE_SAVINGS_NOTIFICATIONS_TABLE=savings_notifications
SUPABASE_SAVINGS_RECONCILIATION_TABLE=savings_reconciliation_alerts

# Warn when a scheduled-job operator's native balance falls below this.
OPERATOR_GAS_MIN=0.5

# Optional Slack/Discord webhook for operator health alerts.
OPS_ALERT_WEBHOOK_URL=

# ─── SaphraONE Unified Payment Engine (Phases A–C) ───────────────────────────
# Apply SQL: packages/database/supabase/payment-intents.sql
#            packages/database/supabase/payment-policies.sql
SUPABASE_PAYMENT_INTENTS_TABLE=payment_intents
SUPABASE_PAYMENT_ATTEMPTS_TABLE=payment_attempts
SUPABASE_PAYMENT_SETTLEMENTS_TABLE=payment_settlements
SUPABASE_PAYMENT_POLICIES_TABLE=payment_policies

# ─── Phase E — Agent Wallet (Circle Developer-Controlled Wallets) ───────────
# Apply SQL: packages/database/supabase/agent-wallets.sql
# Never commit real values. Server-side only — never NEXT_PUBLIC_.
CIRCLE_DEVELOPER_CONTROLLED_API_KEY=
CIRCLE_ENTITY_SECRET=
SUPABASE_AGENT_WALLET_CONFIGS_TABLE=agent_wallet_configs

# ─── Phase H — ALLIE (Anthropic) ────────────────────────────────────────────
# Server-side only. Never logged, echoed, or exposed to the browser.
ANTHROPIC_API_KEY=
# Optional model overrides. Defaults are the current-generation pair.
ALLIE_TIER_TWO_MODEL=claude-haiku-4-5
ALLIE_TIER_THREE_MODEL=claude-sonnet-5

# ─── ALLIE Monetization ─────────────────────────────────────────────────────
# Apply SQL: packages/database/supabase/allie-monetization.sql
ALLIE_PRO_MONTHLY_FEE_USDC=5.00
ALLIE_PER_PAYMENT_FEE_UNITS=2000      # 0.002 USDC at 6 decimals, per policy-approved payment
#ALLIE_PER_CALL_FEE_UNITS=            # deprecated name, still read as a fallback
ALLIE_DAILY_LLM_CALL_BUDGET=50        # total LLM calls per Pro user per day
ALLIE_DAILY_ESCALATION_BUDGET=10      # of those, how many may reach Tier 3
ALLIE_PRO_FEE_RECIPIENT=              # platform address to receive subscription fees
SUPABASE_ALLIE_SUBSCRIPTIONS_TABLE=allie_subscriptions
SUPABASE_ALLIE_LLM_USAGE_TABLE=allie_llm_usage
SUPABASE_ALLIE_LLM_CACHE_TABLE=allie_llm_cache

# Local only: retry Circle/Supabase calls without certificate checks when
# antivirus HTTPS inspection breaks them. Ignored on Vercel. Never set in production.
# ALLOW_INSECURE_LOCAL_TLS=true

# Contract governance (see docs/contracts-governance.md). Required for mainnet deploys.
# SWIFTPAY_MULTISIG_ADDRESS=   # guardian: can pause, never move funds
# SWIFTPAY_TIMELOCK_ADDRESS=   # owner of every contract (pnpm --filter @saphra/contracts deploy:timelock)
# SWIFTPAY_TIMELOCK_DELAY=172800

# Signs wallet sessions. Required outside local dev: openssl rand -hex 32
SAPHRA_SESSION_SECRET=
# The one admin API key, sent as Authorization: Bearer <key>. At least 32 characters.
ADMIN_SECRET=

# SaphraONE Checkout entry points (quick actions, app shortcut, receive QR,
# overview card). "true" to show them; the Checkout pages work by URL either
# way. Card/bank payments use ONRAMP_API_KEY / ONRAMP_REFERRER_DOMAIN, and the
# payment matcher reads ARC_SERVER_RPC_URL (see apps/web/.env.example).
NEXT_PUBLIC_CHECKOUT_ENABLED=

# Multichain receive (MULTICHAIN-PLAN.md): a deposit address per network,
# swept to the user's Arc wallet over CCTP. Off unless "true". Build-time.
# Needs CIRCLE_DEVELOPER_CONTROLLED_API_KEY / CIRCLE_ENTITY_SECRET and
# packages/database/supabase/multichain.sql.
NEXT_PUBLIC_MULTICHAIN_ENABLED=
# Comma list of network keys to offer (base,polygon,arbitrum,optimism,avalanche,ethereum). Empty = all.
NEXT_PUBLIC_MULTICHAIN_NETWORKS=
# Canary: only these Arc wallets (comma list) may use it. Empty = everyone signed in.
MULTICHAIN_ALLOWED_WALLETS=
# Kill switch: "true" keeps detecting deposits but burns nothing.
MULTICHAIN_SWEEPS_PAUSED=
# Optional: pin the Circle wallet set for deposit addresses (otherwise found or created by name).
CIRCLE_DEPOSIT_WALLET_SET_ID=

# Centiiv Protocol (Naira on/off-ramp on Arc, CENTIIV-RAMP-PLAN.md). Server-only.
# Protocol API public key: pk_sandbox_... on testnet builds, pk_live_... on mainnet
# (a mismatch disables the feature). Centiiv's quote, order and banking endpoints
# accept only pk_ keys (sk_ keys get 403; cnt-... keys are the separate Payment API).
CENTIIV_PUBLIC_KEY=
CENTIIV_API_BASE_URL=https://api.centiiv.io
# Svix signing secret (whsec_...) from Centiiv dashboard -> Webhooks.
# Webhook URL to set there: https://<app-host>/api/ramp/webhooks/centiiv
CENTIIV_WEBHOOK_SECRET=
RAMP_CURRENCIES=NGN
# Shows the Withdraw quick action. Build-time; redeploy after changing.
NEXT_PUBLIC_RAMP_ENABLED=
